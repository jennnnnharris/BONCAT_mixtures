dir1 = getDirectory("open file ");
list = getFileList(dir1);
dir2 = dir1+"splits"+File.separator;
for (i=0; i<list.length; i++)
        {
       
        if (File.isDirectory(dir1+list[i])){}
        else{
               
                path = dir1+list[i];
                if (endsWith(path, ".db")){}
                else{
                       
                        open(path);
                        if (bitDepth!=24){}  
                        else {
                                setBatchMode(true);
                                title = File.nameWithoutExtension ;
                                run("Split Channels");
                                saveAs("Jpeg", dir2+"Blue_"+title+".jpg");
                                close();
                                saveAs("Jpeg", dir2+"Green_"+title+".jpg");
                                close();                                
                                saveAs("Jpeg", dir2+"Red_"+title+".jpg");
                                close();
                                setBatchMode(false);

                                }
                        }
                }
        }
